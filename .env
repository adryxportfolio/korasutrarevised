# ---------------------------------------------------------------------
# Supabase server-side access
# Never expose service role keys through VITE_* variables.
# ---------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY="replace_with_supabase_service_role_key"
SUPABASE_DB_URL="replace_with_supabase_postgres_connection_string"

# ---------------------------------------------------------------------
# Customer and admin sessions
# ---------------------------------------------------------------------
CUSTOMER_SESSION_TTL_DAYS="30"
ADMIN_SESSION_TTL_HOURS="24"
SESSION_TOKEN_BYTES="32"
ADMIN_DEFAULT_USERNAME="korasutra_admin"
ADMIN_DEFAULT_PASSWORD="replace_before_production"
ADMIN_PASSWORD_PEPPER="replace_with_random_32_byte_secret"
OTP_HASH_PEPPER="replace_with_random_32_byte_secret"
CRON_SECRET="replace_with_random_cron_secret"

# ---------------------------------------------------------------------
# AISensy WhatsApp OTP auth
# Used by aisensy-send-otp and aisensy-verify-otp.
# ---------------------------------------------------------------------
AISENSY_API_KEY="replace_with_aisensy_api_key"
AISENSY_BASE_URL="https://backend.aisensy.com"
AISENSY_CAMPAIGN_NAME="replace_with_otp_campaign_name"
AISENSY_OTP_TEMPLATE_NAME="replace_with_approved_template_name"
AISENSY_SOURCE="new-landing-page form"
OTP_EXPIRY_MINUTES="10"
OTP_SEND_LIMIT_PER_HOUR="3"
OTP_VERIFY_ATTEMPT_LIMIT="5"

# ---------------------------------------------------------------------
# Razorpay checkout
# VITE_RAZORPAY_KEY_ID is public. RAZORPAY_KEY_SECRET stays server-side.
# ---------------------------------------------------------------------
VITE_RAZORPAY_KEY_ID="replace_with_razorpay_key_id"
RAZORPAY_KEY_ID="replace_with_razorpay_key_id"
RAZORPAY_KEY_SECRET="replace_with_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="replace_with_razorpay_webhook_secret"
RAZORPAY_CURRENCY="INR"
COD_SURCHARGE_INR="200"
FREE_SHIPPING_INR="0"

# ---------------------------------------------------------------------
# Resend transactional email
# Used by send-order-emails and order status notification functions.
# ---------------------------------------------------------------------
RESEND_API_KEY="replace_with_resend_api_key"
RESEND_FROM_EMAIL="Kora Sutra <orders@notify.korasutra.com>"
RESEND_REPLY_TO_EMAIL="customer.support@korasutra.com"
RESEND_AUDIENCE_ID="replace_with_resend_audience_id_if_used"
ORDER_TRACKING_BASE_URL="https://korasutra.com/order-tracking"

# ---------------------------------------------------------------------
# One-time Shopify migration support
# Remove after migrate-shopify-products is complete and verified.
# ---------------------------------------------------------------------
